{
  "manifest_version": 3,
  "name": "pr0Vault",
  "version": "0.3.0",
  "description": "Dein digitales Gedächtnis auf pr0gramm. Auto-Backup, Full-Text-Search, DSGVO-Export.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "downloads",
    "cookies",
    "alarms"
  ],
  "host_permissions": [
    "https://pr0gramm.com/*",
    "https://img.pr0gramm.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "scripts": ["src/background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pr0gramm.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/page-hook.js"
      ],
      "matches": [
        "https://pr0gramm.com/*"
      ]
    }
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "pr0Vault"
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "pr0vault@livvux.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
